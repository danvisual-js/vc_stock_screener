{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/daily-report",
      "schedule": "30 13 * * 1-5"
    }
  ],
  "functions": {
    "api/daily-report.js": {
      "maxDuration": 60
    },
    "api/concierge.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/welcome",
      "destination": "/welcome/index.html"
    }
  ]
}
